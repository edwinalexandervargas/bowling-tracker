# Copy to .env.local (git-ignored) and fill in from Supabase > Project Settings > API Keys.
# Use the PUBLISHABLE key (starts with sb_publishable_). Never put a secret key here:
# anything starting with VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
